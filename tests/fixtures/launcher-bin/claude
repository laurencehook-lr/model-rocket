#!/usr/bin/env bash
set -euo pipefail

if [[ "${1:-}" == "--version" ]]; then
  printf '%s\n' "2.1.222 (Claude Code)"
  exit 0
fi

if [[ -n "${ANTHROPIC_API_KEY:-}" || -n "${ANTHROPIC_AUTH_TOKEN:-}" ]]; then
  echo "Claude inherited an API-key variable" >&2
  exit 74
fi
if [[ -n "${CLAUDE_CODE_USE_BEDROCK:-}" || -n "${CLAUDE_CODE_USE_VERTEX:-}" || -n "${CLAUDE_CODE_USE_FOUNDRY:-}" ]]; then
  echo "Claude inherited an alternate-provider selector" >&2
  exit 77
fi
if [[ -n "${ANTHROPIC_CUSTOM_HEADERS:-}" ]]; then
  echo "Claude received a separate routing header" >&2
  exit 75
fi
if [[ ! "${ANTHROPIC_BASE_URL:-}" =~ ^http://127\.0\.0\.1:[0-9]+/[0-9a-f]{64}$ ]]; then
  echo "Claude did not receive a loopback router URL" >&2
  exit 76
fi
if [[ "${ANTHROPIC_CUSTOM_MODEL_OPTION:-}" != "gpt-5.6-sol" ]]; then
  echo "Claude did not receive the GPT custom model" >&2
  exit 78
fi
if [[ "${CLAUDE_CODE_MAX_CONTEXT_TOKENS:-}" != "272000" ]]; then
  echo "Claude did not receive the GPT context window" >&2
  exit 80
fi
for required_bypass in localhost 127.0.0.1 ::1 '[::1]' existing-upper.example existing-lower.example; do
  if [[ ",${NO_PROXY:-}," != *",${required_bypass},"* ]]; then
    echo "NO_PROXY is missing $required_bypass" >&2
    exit 83
  fi
  if [[ ",${no_proxy:-}," != *",${required_bypass},"* ]]; then
    echo "no_proxy is missing $required_bypass" >&2
    exit 84
  fi
done
if [[ " $* " != *" --model claude-fable-5 "* ]]; then
  echo "Claude did not start with Fable as the lead model" >&2
  exit 79
fi

settings_file=""
while (($#)); do
  if [[ "$1" == "--settings" ]]; then
    shift
    settings_file="${1:-}"
    break
  fi
  shift
done
if [[ -z "$settings_file" || ! -f "$settings_file" ]]; then
  echo "Claude did not receive a routing settings file" >&2
  exit 82
fi

python3 - "$settings_file" <<'PY'
import json
import os
import stat
import sys

settings_file = sys.argv[1]
with open(settings_file, encoding="utf-8") as settings_handle:
    routing = json.load(settings_handle).get("env", {})
base_url = routing.get("ANTHROPIC_BASE_URL", "")
if not base_url.startswith("http://127.0.0.1:") or len(base_url.rsplit("/", 1)[-1]) != 64:
    raise SystemExit("routing settings do not contain the loopback URL")
if "ANTHROPIC_CUSTOM_HEADERS" in routing:
    raise SystemExit("routing settings contain a separate local token header")
if routing.get("ANTHROPIC_CUSTOM_MODEL_OPTION") != "gpt-5.6-sol":
    raise SystemExit("routing settings do not contain the GPT model")
if routing.get("ANTHROPIC_CUSTOM_MODEL_OPTION_NAME") != "GPT through Codex subscription":
    raise SystemExit("routing settings do not contain the GPT model label")
if routing.get("CLAUDE_CODE_MAX_CONTEXT_TOKENS") != "272000":
    raise SystemExit("routing settings do not contain the GPT context window")
for name in ("NO_PROXY", "no_proxy"):
    bypasses = routing.get(name, "").split(",")
    for required in ("localhost", "127.0.0.1", "::1", "[::1]", "existing-upper.example", "existing-lower.example"):
        if required not in bypasses:
            raise SystemExit(f"routing settings {name} does not contain {required}")
if stat.S_IMODE(os.stat(settings_file).st_mode) != 0o600:
    raise SystemExit("routing settings permissions are not 0600")
PY

printf '%s\n%s\n' "launcher environment isolated" "$settings_file" >"$LAUNCHER_PROOF_FILE"
